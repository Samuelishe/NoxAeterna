{"schemaVersion":1,"resourceType":"synthesis-fragment","resourceId":"mixed-transitions","data":{"text":"\u0421\u043E\u0441\u0435\u0434\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B \u0434\u0430\u044E\u0442 \u0441\u043C\u0435\u0448\u0430\u043D\u043D\u044B\u0435 \u0441\u0438\u0433\u043D\u0430\u043B\u044B, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438\u0442\u043E\u0433 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A\u0430\u044F \u0441\u0432\u044F\u0437\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435."}}
