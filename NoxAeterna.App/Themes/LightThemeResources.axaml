<ResourceDictionary
    x:Class="NoxAeterna.App.Themes.LightThemeResources"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="DesignCanvasColor">#F7F5FC</Color>
  <Color x:Key="DesignSurfaceColor">#FFFFFF</Color>
  <Color x:Key="DesignSurfaceRaisedColor">#EEEAF7</Color>
  <Color x:Key="DesignSurfaceSunkenColor">#F2EFF8</Color>
  <Color x:Key="DesignBorderColor">#D6D1E3</Color>
  <Color x:Key="DesignBorderStrongColor">#B7AEC9</Color>
  <Color x:Key="DesignTextPrimaryColor">#1C1930</Color>
  <Color x:Key="DesignTextSecondaryColor">#67617B</Color>
  <Color x:Key="DesignTextMutedColor">#8A849A</Color>
  <Color x:Key="DesignAccentPrimaryColor">#7357D9</Color>
  <Color x:Key="DesignAccentPrimaryStrongColor">#5E3FC4</Color>
  <Color x:Key="DesignAccentPrimarySoftColor">#E9E3FF</Color>
  <Color x:Key="DesignAccentSecondaryColor">#147F91</Color>
  <Color x:Key="DesignAccentSecondarySoftColor">#DDF3F6</Color>
  <Color x:Key="DesignSolarAccentColor">#8C5A00</Color>
  <Color x:Key="DesignSuccessColor">#137A55</Color>
  <Color x:Key="DesignWarningColor">#8C5A00</Color>
  <Color x:Key="DesignErrorColor">#B8344D</Color>
  <Color x:Key="DesignControlFillColor">#FFFFFF</Color>
  <Color x:Key="DesignControlFillHoverColor">#F1EDF9</Color>
  <Color x:Key="DesignControlFillPressedColor">#E5DFF1</Color>
  <Color x:Key="DesignDisabledFillColor">#EEEAF3</Color>
  <Color x:Key="DesignDisabledTextColor">#9A93A8</Color>
  <Color x:Key="DesignSelectionForegroundColor">#FFFFFF</Color>
  <Color x:Key="DesignFocusRingColor">#147F91</Color>

  <SolidColorBrush x:Key="DesignCanvasBrush" Color="{StaticResource DesignCanvasColor}" />
  <SolidColorBrush x:Key="DesignSurfaceBrush" Color="{StaticResource DesignSurfaceColor}" />
  <SolidColorBrush x:Key="DesignSurfaceRaisedBrush" Color="{StaticResource DesignSurfaceRaisedColor}" />
  <SolidColorBrush x:Key="DesignSurfaceSunkenBrush" Color="{StaticResource DesignSurfaceSunkenColor}" />
  <SolidColorBrush x:Key="DesignBorderBrush" Color="{StaticResource DesignBorderColor}" />
  <SolidColorBrush x:Key="DesignBorderStrongBrush" Color="{StaticResource DesignBorderStrongColor}" />
  <SolidColorBrush x:Key="DesignTextPrimaryBrush" Color="{StaticResource DesignTextPrimaryColor}" />
  <SolidColorBrush x:Key="DesignTextSecondaryBrush" Color="{StaticResource DesignTextSecondaryColor}" />
  <SolidColorBrush x:Key="DesignTextMutedBrush" Color="{StaticResource DesignTextMutedColor}" />
  <SolidColorBrush x:Key="DesignAccentPrimaryBrush" Color="{StaticResource DesignAccentPrimaryColor}" />
  <SolidColorBrush x:Key="DesignAccentPrimaryStrongBrush" Color="{StaticResource DesignAccentPrimaryStrongColor}" />
  <SolidColorBrush x:Key="DesignAccentPrimarySoftBrush" Color="{StaticResource DesignAccentPrimarySoftColor}" />
  <SolidColorBrush x:Key="DesignAccentSecondaryBrush" Color="{StaticResource DesignAccentSecondaryColor}" />
  <SolidColorBrush x:Key="DesignAccentSecondarySoftBrush" Color="{StaticResource DesignAccentSecondarySoftColor}" />
  <SolidColorBrush x:Key="DesignSolarAccentBrush" Color="{StaticResource DesignSolarAccentColor}" />
  <SolidColorBrush x:Key="DesignSuccessBrush" Color="{StaticResource DesignSuccessColor}" />
  <SolidColorBrush x:Key="DesignWarningBrush" Color="{StaticResource DesignWarningColor}" />
  <SolidColorBrush x:Key="DesignErrorBrush" Color="{StaticResource DesignErrorColor}" />
  <SolidColorBrush x:Key="DesignControlFillBrush" Color="{StaticResource DesignControlFillColor}" />
  <SolidColorBrush x:Key="DesignControlFillHoverBrush" Color="{StaticResource DesignControlFillHoverColor}" />
  <SolidColorBrush x:Key="DesignControlFillPressedBrush" Color="{StaticResource DesignControlFillPressedColor}" />
  <SolidColorBrush x:Key="DesignDisabledFillBrush" Color="{StaticResource DesignDisabledFillColor}" />
  <SolidColorBrush x:Key="DesignDisabledTextBrush" Color="{StaticResource DesignDisabledTextColor}" />
  <SolidColorBrush x:Key="DesignSelectionForegroundBrush" Color="{StaticResource DesignSelectionForegroundColor}" />
  <SolidColorBrush x:Key="DesignFocusRingBrush" Color="{StaticResource DesignFocusRingColor}" />

  <!-- Public Fluent 12.0.2 resource seams retained for native editor and popup behavior. -->
  <StaticResource x:Key="SystemAccentColor" ResourceKey="DesignAccentPrimaryColor" />
  <StaticResource x:Key="SystemAccentColorLight1" ResourceKey="DesignAccentPrimaryColor" />
  <StaticResource x:Key="SystemAccentColorLight2" ResourceKey="DesignAccentPrimaryColor" />
  <StaticResource x:Key="SystemAccentColorLight3" ResourceKey="DesignAccentPrimaryColor" />
  <StaticResource x:Key="SystemAccentColorDark1" ResourceKey="DesignAccentPrimaryStrongColor" />
  <StaticResource x:Key="SystemAccentColorDark2" ResourceKey="DesignAccentPrimaryStrongColor" />
  <StaticResource x:Key="SystemAccentColorDark3" ResourceKey="DesignAccentPrimaryStrongColor" />

  <StaticResource x:Key="ButtonBackground" ResourceKey="DesignSurfaceRaisedBrush" />
  <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="DesignAccentPrimarySoftBrush" />
  <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="DesignControlFillPressedBrush" />
  <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="DesignDisabledFillBrush" />
  <StaticResource x:Key="ButtonForeground" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="ButtonBorderBrush" ResourceKey="DesignBorderStrongBrush" />
  <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="DesignAccentPrimaryBrush" />
  <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="DesignBorderStrongBrush" />
