  <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="DesignAccentPrimaryBrush" />
  <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="DesignAccentPrimaryStrongBrush" />
  <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="DesignDisabledFillBrush" />
  <StaticResource x:Key="AccentButtonForeground" ResourceKey="DesignSelectionForegroundBrush" />
  <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="DesignSelectionForegroundBrush" />
  <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="DesignSelectionForegroundBrush" />
  <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="AccentButtonBorderBrush" ResourceKey="DesignAccentPrimaryStrongBrush" />
  <StaticResource x:Key="AccentButtonBorderBrushPointerOver" ResourceKey="DesignAccentPrimaryBrush" />
  <StaticResource x:Key="AccentButtonBorderBrushPressed" ResourceKey="DesignAccentPrimaryStrongBrush" />
  <StaticResource x:Key="AccentButtonBorderBrushDisabled" ResourceKey="DesignBorderBrush" />

  <StaticResource x:Key="TextControlForeground" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="TextControlBackground" ResourceKey="DesignControlFillBrush" />
  <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="DesignControlFillHoverBrush" />
  <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="DesignControlFillBrush" />
  <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="DesignDisabledFillBrush" />
  <StaticResource x:Key="TextControlBorderBrush" ResourceKey="DesignBorderBrush" />
  <StaticResource x:Key="TextControlBorderBrushPointerOver" ResourceKey="DesignBorderStrongBrush" />
  <StaticResource x:Key="TextControlBorderBrushFocused" ResourceKey="DesignFocusRingBrush" />
  <StaticResource x:Key="TextControlBorderBrushDisabled" ResourceKey="DesignBorderBrush" />
  <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="DesignTextMutedBrush" />
  <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="DesignTextMutedBrush" />
  <StaticResource x:Key="TextControlPlaceholderForegroundDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="TextControlSelectionHighlightColor" ResourceKey="DesignAccentPrimarySoftBrush" />

  <StaticResource x:Key="ComboBoxBackground" ResourceKey="DesignControlFillBrush" />
  <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="DesignControlFillHoverBrush" />
  <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="DesignControlFillPressedBrush" />
  <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="DesignDisabledFillBrush" />
  <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="DesignControlFillBrush" />
  <StaticResource x:Key="ComboBoxBackgroundBorderBrushFocused" ResourceKey="DesignFocusRingBrush" />
  <StaticResource x:Key="ComboBoxBackgroundBorderBrushUnfocused" ResourceKey="DesignBorderBrush" />
  <StaticResource x:Key="ComboBoxForeground" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxForegroundDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxForegroundFocusedPressed" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxPlaceHolderForeground" ResourceKey="DesignTextMutedBrush" />
  <StaticResource x:Key="ComboBoxPlaceHolderForegroundFocusedPressed" ResourceKey="DesignTextMutedBrush" />
