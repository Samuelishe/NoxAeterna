  <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="DesignBorderStrongBrush" />
  <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="DesignFocusRingBrush" />
