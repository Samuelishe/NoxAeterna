  <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocused" ResourceKey="DesignAccentSecondaryBrush" />
  <StaticResource x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" ResourceKey="DesignAccentSecondaryBrush" />
  <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="DesignSurfaceBrush" />
  <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="DesignBorderStrongBrush" />
  <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxItemForegroundDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="ComboBoxItemForegroundSelectedDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="ComboBoxItemBackground" ResourceKey="DesignSurfaceBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="DesignControlFillPressedBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="DesignSurfaceRaisedBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundDisabled" ResourceKey="DesignDisabledFillBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="DesignAccentPrimarySoftBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="DesignControlFillPressedBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="DesignSurfaceRaisedBrush" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelectedDisabled" ResourceKey="DesignDisabledFillBrush" />

  <StaticResource x:Key="DatePickerButtonBorderBrush" ResourceKey="DesignBorderBrush" />
  <StaticResource x:Key="DatePickerButtonBorderBrushPointerOver" ResourceKey="DesignBorderStrongBrush" />
  <StaticResource x:Key="DatePickerButtonBorderBrushPressed" ResourceKey="DesignFocusRingBrush" />
  <StaticResource x:Key="DatePickerButtonBorderBrushDisabled" ResourceKey="DesignBorderBrush" />
  <StaticResource x:Key="DatePickerButtonBackground" ResourceKey="DesignControlFillBrush" />
  <StaticResource x:Key="DatePickerButtonBackgroundPointerOver" ResourceKey="DesignControlFillHoverBrush" />
  <StaticResource x:Key="DatePickerButtonBackgroundPressed" ResourceKey="DesignControlFillPressedBrush" />
  <StaticResource x:Key="DatePickerButtonBackgroundDisabled" ResourceKey="DesignDisabledFillBrush" />
  <StaticResource x:Key="DatePickerButtonForeground" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="DatePickerButtonForegroundPointerOver" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="DatePickerButtonForegroundPressed" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="DatePickerButtonForegroundDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="DatePickerFlyoutPresenterBackground" ResourceKey="DesignSurfaceBrush" />
  <StaticResource x:Key="DatePickerFlyoutPresenterBorderBrush" ResourceKey="DesignBorderStrongBrush" />
  <StaticResource x:Key="DatePickerFlyoutPresenterHighlightFill" ResourceKey="DesignAccentPrimarySoftBrush" />
  <StaticResource x:Key="TimePickerButtonBorderBrush" ResourceKey="DesignBorderBrush" />
  <StaticResource x:Key="TimePickerButtonBorderBrushPointerOver" ResourceKey="DesignBorderStrongBrush" />
  <StaticResource x:Key="TimePickerButtonBorderBrushPressed" ResourceKey="DesignFocusRingBrush" />
  <StaticResource x:Key="TimePickerButtonBorderBrushDisabled" ResourceKey="DesignBorderBrush" />
  <StaticResource x:Key="TimePickerButtonBackground" ResourceKey="DesignControlFillBrush" />
  <StaticResource x:Key="TimePickerButtonBackgroundPointerOver" ResourceKey="DesignControlFillHoverBrush" />
  <StaticResource x:Key="TimePickerButtonBackgroundPressed" ResourceKey="DesignControlFillPressedBrush" />
  <StaticResource x:Key="TimePickerButtonBackgroundDisabled" ResourceKey="DesignDisabledFillBrush" />
  <StaticResource x:Key="TimePickerButtonForeground" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="TimePickerButtonForegroundPointerOver" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="TimePickerButtonForegroundPressed" ResourceKey="DesignTextPrimaryBrush" />
  <StaticResource x:Key="TimePickerButtonForegroundDisabled" ResourceKey="DesignDisabledTextBrush" />
  <StaticResource x:Key="TimePickerFlyoutPresenterBackground" ResourceKey="DesignSurfaceBrush" />
  <StaticResource x:Key="TimePickerFlyoutPresenterBorderBrush" ResourceKey="DesignBorderStrongBrush" />
  <StaticResource x:Key="TimePickerFlyoutPresenterHighlightFill" ResourceKey="DesignAccentPrimarySoftBrush" />
  <StaticResource x:Key="DateTimePickerFlyoutButtonBackgroundPointerOver" ResourceKey="DesignSurfaceRaisedBrush" />
  <StaticResource x:Key="DateTimePickerFlyoutButtonBackgroundPressed" ResourceKey="DesignControlFillPressedBrush" />

  <StaticResource x:Key="ScrollBarBackground" ResourceKey="DesignSurfaceSunkenBrush" />
  <StaticResource x:Key="ScrollBarBackgroundPointerOver" ResourceKey="DesignSurfaceSunkenBrush" />
  <StaticResource x:Key="ScrollBarThumbFillPointerOver" ResourceKey="DesignBorderStrongBrush" />
