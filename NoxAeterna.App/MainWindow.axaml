<Window
    x:Class="NoxAeterna.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:NoxAeterna.App.Shell"
    Title="Nox Aeterna"
    Background="{DynamicResource DesignCanvasBrush}"
    Foreground="{DynamicResource DesignTextPrimaryBrush}"
    Width="1360"
    Height="860"
    MinWidth="1180"
    MinHeight="760">
  <Grid Margin="20">
    <SplitView x:Name="ShellSplitView"
               DisplayMode="CompactInline"
               PanePlacement="Left"
               PaneBackground="Transparent">
      <SplitView.Pane>
        <Border x:Name="NavigationPaneBorder"
                Padding="10"
                Background="{DynamicResource DesignSurfaceBrush}"
                BorderBrush="{DynamicResource DesignBorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid RowDefinitions="Auto,*">
            <Grid Height="38">
              <TextBlock x:Name="NavigationTitleTextBlock"
                         VerticalAlignment="Center"
                         Margin="6,0,44,0"
                         FontSize="16"
                         FontWeight="SemiBold" />
              <Button x:Name="NavigationToggleButton"
                      Classes="navigation-toggle"
                      Width="36"
                      Height="36"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Click="OnNavigationToggleClick">
                <Path x:Name="NavigationToggleIcon"
                      Width="20"
                      Height="20"
                      Data="M19,4 L19,20 M15,5 L8,12 L15,19"
                      Fill="Transparent"
                      Stroke="{DynamicResource DesignTextSecondaryBrush}"
                      StrokeThickness="1.7"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Stretch="Uniform"
                      IsHitTestVisible="False" />
              </Button>
            </Grid>

            <ListBox x:Name="NavigationListBox"
                     Grid.Row="1"
                     Margin="0,10,0,0"
                     Classes="navigation-list"
                     SelectionChanged="OnNavigationSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="shell:ShellNavigationItemView">
                  <StackPanel Classes="navigation-item-content"
                              Orientation="Horizontal"
                              Spacing="12"
                              VerticalAlignment="Center">
                    <Path Width="22"
                          Height="22"
                          Data="{Binding IconGeometry}"
                          Fill="Transparent"
                          Stroke="{DynamicResource DesignTextSecondaryBrush}"
                          StrokeThickness="1.7"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Stretch="Uniform"
                          IsHitTestVisible="False" />
                    <TextBlock Classes="navigation-label"
                               VerticalAlignment="Center"
                               Text="{Binding Label}"
                               IsVisible="{Binding IsLabelVisible}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </SplitView.Pane>

      <SplitView.Content>
        <Grid Margin="20,8,0,0"
              RowDefinitions="Auto,Auto,*">
          <TextBlock x:Name="SectionTitleTextBlock"
                     FontSize="21"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="SectionHintTextBlock"
                     Grid.Row="1"
                     Classes="supporting"
                     Margin="0,6,0,0" />
          <ContentControl x:Name="SectionContentHost"
                          Grid.Row="2"
                          Margin="0,16,0,0" />
        </Grid>
      </SplitView.Content>
    </SplitView>
  </Grid>
</Window>
