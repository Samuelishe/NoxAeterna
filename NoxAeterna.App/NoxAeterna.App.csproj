<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\NoxAeterna.Astronomy\\NoxAeterna.Astronomy.csproj" />
    <ProjectReference Include="..\NoxAeterna.Domain\NoxAeterna.Domain.csproj" />
    <ProjectReference Include="..\NoxAeterna.Geometry\NoxAeterna.Geometry.csproj" />
    <ProjectReference Include="..\NoxAeterna.Interpretation\NoxAeterna.Interpretation.csproj" />
    <ProjectReference Include="..\NoxAeterna.Presentation\NoxAeterna.Presentation.csproj" />
    <ProjectReference Include="..\NoxAeterna.Rendering\NoxAeterna.Rendering.csproj" />
    <ProjectReference Include="..\NoxAeterna.Infrastructure\NoxAeterna.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\resources\localization\ui\*.json"
          Link="resources\localization\ui\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\resources\assets\tarot\artwork-packs\lupus-noctis\artwork-pack.json"
          Link="resources\assets\tarot\artwork-packs\lupus-noctis\artwork-pack.json"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
    <None Include="..\resources\assets\tarot\artwork-packs\lupus-noctis\cards\**\*.png"
          Link="resources\assets\tarot\artwork-packs\lupus-noctis\cards\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\resources\interpretation\tarot\packs\**\interpretation-pack.json"
          Link="resources\interpretation\tarot\packs\%(RecursiveDir)interpretation-pack.json"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
    <None Include="..\resources\interpretation\tarot\packs\**\indexes\**\*.json"
          Link="resources\interpretation\tarot\packs\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
    <None Include="..\resources\interpretation\tarot\packs\**\content\**\*.json"
          Link="resources\interpretation\tarot\packs\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
