<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InterpretationSourceRoot>$(MSBuildProjectDirectory)\..\resources\interpretation\tarot\sources\classic</InterpretationSourceRoot>
    <InterpretationCompiledPackage>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\interpretation\classic.noxinterp</InterpretationCompiledPackage>
    <InterpretationCompilerAssembly>$(MSBuildProjectDirectory)\..\NoxAeterna.Tools.Repository\bin\$(Configuration)\net10.0\NoxAeterna.Tools.Repository.dll</InterpretationCompilerAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\\NoxAeterna.Astronomy\\NoxAeterna.Astronomy.csproj" />
    <ProjectReference Include="..\NoxAeterna.Domain\NoxAeterna.Domain.csproj" />
    <ProjectReference Include="..\NoxAeterna.Geometry\NoxAeterna.Geometry.csproj" />
    <ProjectReference Include="..\NoxAeterna.Interpretation\NoxAeterna.Interpretation.csproj" />
    <ProjectReference Include="..\NoxAeterna.Interpretation.Sqlite\NoxAeterna.Interpretation.Sqlite.csproj" />
    <ProjectReference Include="..\NoxAeterna.Tools.Repository\NoxAeterna.Tools.Repository.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all" />
    <ProjectReference Include="..\NoxAeterna.Presentation\NoxAeterna.Presentation.csproj" />
    <ProjectReference Include="..\NoxAeterna.Rendering\NoxAeterna.Rendering.csproj" />
    <ProjectReference Include="..\NoxAeterna.Infrastructure\NoxAeterna.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\resources\localization\ui\*.json"
          Link="resources\localization\ui\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\resources\assets\tarot\artwork-packs\lupus-noctis\artwork-pack.json"
          Link="resources\assets\tarot\artwork-packs\lupus-noctis\artwork-pack.json"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
    <None Include="..\resources\assets\tarot\artwork-packs\lupus-noctis\cards\**\*.png"
          Link="resources\assets\tarot\artwork-packs\lupus-noctis\cards\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <InterpretationSource Include="$(InterpretationSourceRoot)\**\*.json" />
    <Content Include="$(InterpretationCompiledPackage)"
             Link="resources\interpretation\tarot\packs\classic.noxinterp"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="CompileBuiltInInterpretationPackage"
          BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish"
          Inputs="@(InterpretationSource);$(InterpretationCompilerAssembly)"
          Outputs="$(InterpretationCompiledPackage)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(InterpretationCompiledPackage)'))" />
    <Exec Command="dotnet &quot;$(InterpretationCompilerAssembly)&quot; interpretation-pack compile --source-root &quot;$(InterpretationSourceRoot)&quot; --output &quot;$(InterpretationCompiledPackage)&quot;" />
  </Target>
</Project>
